# ─── V-Nav Client Environment Variables ──────────────────────────────────────
# Copy this file to .env (for local dev) or set these in your Vercel dashboard.

# Mapbox public token — get one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Backend API base URL
# Local dev:   http://localhost:3000
# Production:  https://your-railway-app.up.railway.app
VITE_API_URL=http://localhost:3000

# Socket.IO server URL (same as API URL)
# Local dev:   http://localhost:3000
# Production:  https://your-railway-app.up.railway.app
VITE_SOCKET_URL=http://localhost:3000
