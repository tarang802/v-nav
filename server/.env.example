# V-Nav API configuration. Copy to .env and fill in. PLACEHOLDERS ONLY: never commit real values.
# Full reference: docs/DEPLOYMENT.md §4

NODE_ENV=development
PORT=3000
# Reverse-proxy hops in front of the API (0 locally, 1 behind Nginx/LB)
TRUST_PROXY=0

CLIENT_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173

# Local Docker Compose replica set (directConnection because the member advertises "mongo:27017")
MONGO_URI=mongodb://localhost:27018/vnav?directConnection=true
REDIS_URL=redis://localhost:6380/0

# Each must be 32+ random characters and all three different. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-48-random-bytes-base64url-aaaaaaaaaa
OTP_SECRET=replace-with-48-random-bytes-base64url-bbbbbbbbbbbbbbb
IP_HASH_SECRET=replace-with-48-random-bytes-base64url-cccccccccccc

ALLOWED_EMAIL_DOMAINS=vitstudent.ac.in

# Local: Mailpit (inbox at http://localhost:8025). Production: your SMTP provider.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="V-Nav <no-reply@vnav.example>"

# Browsers accept Secure cookies on http://localhost, so this can stay true locally.
COOKIE_SECURE=true

LOG_LEVEL=info

# Campus geofence (GeoJSON Polygon/MultiPolygon). Positions outside it are never shared.
# Default ships with the server (OpenStreetMap, ODbL); see data/README.md.
CAMPUS_BOUNDARY_FILE=data/campus-boundary.geojson

# Optional label for this replica in logs; defaults to hostname:pid.
# INSTANCE_ID=api1
